{
  "name": "blindspot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "test": "vitest run",
    "test:contrast": "npx tsx scripts/test-contrast.ts",
    "hello-models": "npx tsx scripts/hello-models.ts",
    "seed-replays": "npx tsx scripts/seed-replays.ts",
    "bench": "npx tsx packages/bench/src/cli.ts",
    "bench:code": "npx tsx packages/bench/src/cli-code.ts",
    "scan-secrets": "bash scripts/scan-secrets.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "tsx": "^4.16.0"
  }
}
