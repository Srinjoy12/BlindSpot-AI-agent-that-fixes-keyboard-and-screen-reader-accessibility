    "barriers": [
      {
        "id": "barrier_1",
        "detectorId": "D1",
        "severity": "blocker",
        "selector": "#name",
        "wcagId": "2.1.2",
        "wcagName": "No Keyboard Trap",
        "wcagUrl": "https://www.w3.org/WAI/WCAG22/Understanding/no-keyboard-trap",
        "impact": "Users navigating with keyboard or assistive technology cannot properly interact with #name: Focus cycles among 3 elements across 6 stops.  Escape did not free focus.",
        "evidence": "Focus cycles among 3 elements across 6 stops.  Escape did not free focus.",
        "fix": {
          "patchType": "script",
          "targetSelector": "#name",
          "body": "document.addEventListener('keydown', function(e) {\n  if (e.key === 'Escape') {\n    const dialog = document.querySelector('#name');\n    if (dialog) {\n      if (typeof dialog.close === 'function') dialog.close();\n      else dialog.style.display = 'none';\n    }\n  }\n});",
          "rationale": "Adds standard Escape key listener to close the trapped modal dialog and restore page focus."
        },
        "verified": false,
        "alsoReportedByAxe": false
      },
      {
        "id": "barrier_2",
        "detectorId": "D2",
        "severity": "blocker",
        "selector": "#dept-trigger",
        "wcagId": "2.1.1",
        "wcagName": "Keyboard",
        "wcagUrl": "https://www.w3.org/WAI/WCAG22/Understanding/keyboard",
        "impact": "Users navigating with keyboard or assistive technology cannot properly interact with #dept-trigger: Interactive element never received focus during the Tab crawl of 6 stops.",
        "evidence": "Interactive element never received focus during the Tab crawl of 6 stops.",
        "fix": {
          "patchType": "html",
          "body": "<button class=\"select-trigger\" id=\"dept-trigger\" onclick=\"toggleDropdown()\" type=\"button\">\n          Select a department\n        </button>",
          "rationale": "Replacing the non-focusable div with a native button element provides built-in keyboard focus and activation (Enter/Space) while preserving existing styling and behavior.",
          "targetSelector": "#dept-trigger"
        },
        "verified": true,
        "verificationEvidence": "Chromium keyboard re-crawl confirmed barrier eliminated with 0 regressions.",
        "alsoReportedByAxe": false
      }
