        "id": "barrier_1",
        "detectorId": "D1",
        "severity": "blocker",
        "selector": "#subscribe-btn",
        "wcagId": "2.1.2",
        "wcagName": "No Keyboard Trap",
        "wcagUrl": "https://www.w3.org/WAI/WCAG22/Understanding/no-keyboard-trap",
        "impact": "Users navigating with keyboard or assistive technology cannot properly interact with #subscribe-btn: Focus cycles among 3 elements across 6 stops. Trapped inside an open dialog. Escape did not free focus.",
        "evidence": "Focus cycles among 3 elements across 6 stops. Trapped inside an open dialog. Escape did not free focus.",
        "fix": {
          "patchType": "script",
          "targetSelector": "#subscribe-btn",
          "body": "document.addEventListener('keydown', function(e) {\n  if (e.key === 'Escape') {\n    const dialog = document.querySelector('#subscribe-btn');\n    if (dialog) {\n      if (typeof dialog.close === 'function') dialog.close();\n      else dialog.style.display = 'none';\n    }\n  }\n});",
          "rationale": "Adds standard Escape key listener to close the trapped modal dialog and restore page focus."
        },
        "verified": false
      },
      {
        "id": "barrier_2",
        "detectorId": "D2",
