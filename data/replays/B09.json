        "selector": "#carousel-prev",
        "wcagId": "2.1.1",
        "wcagName": "Keyboard",
        "wcagUrl": "https://www.w3.org/WAI/WCAG22/Understanding/keyboard",
        "impact": "Users navigating with keyboard or assistive technology cannot properly interact with #carousel-prev: Interactive element never received focus during the Tab crawl of 7 stops.",
        "evidence": "Interactive element never received focus during the Tab crawl of 7 stops.",
        "fix": {
          "patchType": "css",
          "targetSelector": "#carousel-prev",
          "body": "#carousel-prev:focus-visible { outline: 2px solid #2563eb !important; }",
          "rationale": "Standard focus indicator repair."
        },
        "verified": false,
        "alsoReportedByAxe": false
      },
      {
        "id": "barrier_2",
        "detectorId": "D2",
        "severity": "blocker",
        "selector": "#carousel-next",
        "wcagId": "2.1.1",
        "wcagName": "Keyboard",
        "wcagUrl": "https://www.w3.org/WAI/WCAG22/Understanding/keyboard",
        "impact": "Users navigating with keyboard or assistive technology cannot properly interact with #carousel-next: Interactive element never received focus during the Tab crawl of 7 stops.",
        "evidence": "Interactive element never received focus during the Tab crawl of 7 stops.",
        "fix": {
          "patchType": "attribute",
          "body": "tabindex=\"0\"",
          "rationale": "The button has tabindex=\"-1\" which explicitly removes it from the tab order; changing to tabindex=\"0\" restores native keyboard focusability while preserving the existing ARIA label and button semantics.",
          "targetSelector": "#carousel-next"
        },
        "verified": true,
        "verificationEvidence": "Chromium keyboard re-crawl confirmed barrier eliminated with 0 regressions.",
        "alsoReportedByAxe": false
      }
