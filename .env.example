# Environment variables — copy to .env and fill in values. NEVER commit .env.

# Nebius Token Factory
TF_API_KEY=
TF_BASE_URL=

# Nemotron model identifiers (confirm from Token Factory catalog on day 1)
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=

# Tavily
TAVILY_API_KEY=

# Budget and rate limits
DAILY_TOKEN_BUDGET=500000
MAX_CONCURRENT_AUDITS=2
RATE_LIMIT_PER_IP_PER_HOUR=6

# Local Dev Server Bridge (disabled by default; requires same-machine execution and ownership attestation)
# ENABLE_LOCAL_DEV_BRIDGE=false

